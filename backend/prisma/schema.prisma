generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  line        Line
  description String
  sizes       String[]
  tag         String?
  stockBySize Json     @default("{}")
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems   OrderItem[]
  interactions WebInteraction[]

  @@map("products")
}

model Customer {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  empresa   String?
  telefono  String?
  localidad String?
  tipo      String   @default("particular")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes       Quote[]
  orders       Order[]
  interactions WebInteraction[]

  @@map("customers")
}

model Quote {
  id         String      @id @default(cuid())
  sessionId  String
  contact    Json
  items      Json
  status     QuoteStatus @default(PENDING)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  order Order?

  @@map("quotes")
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  quoteId    String?     @unique
  quote      Quote?      @relation(fields: [quoteId], references: [id])
  estado     OrderStatus @default(PENDIENTE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  nombre    String
  size      String
  cantidad  Int

  @@map("order_items")
}

model WebInteraction {
  id         String    @id @default(cuid())
  sessionId  String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  tipo       String
  createdAt  DateTime  @default(now())

  @@map("web_interactions")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

enum Line {
  roja
  dorada
}

enum QuoteStatus {
  PENDING
  CONTACTED
  CLOSED
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  CANCELADO
}
