                            "title": "Elements with `role=\"dialog\"` or `role=\"alertdialog\"` have accessible names.",
                            "description": "ARIA dialog elements without accessible names may prevent screen readers users from discerning the purpose of these elements. [Learn how to make ARIA dialog elements more accessible](https://dequeuniversity.com/rules/axe/4.13/aria-dialog-name).",
                            "score": null,
                            "scoreDisplayMode": "notApplicable"
                          },
