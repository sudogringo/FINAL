{"updatedAt":"2026-08-04T20:29:52.324Z","createdAt":"2026-06-16T20:51:20.964Z","id":"hcUaHpeXUYfqQMkK","name":"06a. Newsletter Quincenal","description":"Envía newsletter quincenal personalizado a suscriptores segmentados por interés de producto.","active":false,"isArchived":false,"nodes":[{"parameters":{"content":"## 🟢 MODO TESIS — Newsletter Quincenal\nFlujo activo para la demo universitaria:\n1. **Manual Trigger** — ejecutar manualmente\n2. **HTTP Request** → `GET /mock/newsletter-subscribers` (API simulada, sin credenciales)\n3. **Code** — Segmentar por categoría de interés (vino, oliva, mix)\n4. **Split In Batches** — procesa un suscriptor a la vez\n5. **Code** — Genera HTML personalizado en español\n6. **Gmail** — Envía email real a `tiagoboberg@gmail.com`\n\n> ⚠️ Requiere credencial **Gmail OAuth2** configurada en n8n.","height":626,"width":1884,"color":3},"id":"sticky-tesis-header","name":"🟢 MODO TESIS","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,16]},{"parameters":{"content":"## 🔴 MODO PRODUCCIÓN — Newsletter Quincenal\nNodos deshabilitados para la demo. En producción, habilitar:\n- **Schedule Trigger** — cron quincenal (días 1 y 15)\n- **Google Sheets** — leer lista real de suscriptores\n- **AI Agent (Gemini)** — generar contenido personalizado con IA\n- **Gmail** — envío real de emails\n- **Google Sheets** — registrar envío en log\n\nCredenciales necesarias: Google OAuth2, Google Sheets ID, Gmail.","height":802,"width":1884},"id":"sticky-prod-header","name":"🔴 MODO PRODUCCIÓN","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,640]},{"parameters":{"content":"**Trigger**","height":200,"width":200,"color":3},"id":"sticky-t-trigger","name":"Sticky T Trigger","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,368]},{"parameters":{"content":"**Fetch**","height":200,"width":200,"color":3},"id":"sticky-t-fetch","name":"Sticky T Fetch","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[400,368]},{"parameters":{"content":"**Segmentar**","height":200,"width":200,"color":3},"id":"sticky-t-segment","name":"Sticky T Segment","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[720,368]},{"parameters":{"content":"**Generar Email**","height":200,"width":200,"color":3},"id":"sticky-t-email","name":"Sticky T Email","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1056,368]},{"parameters":{"content":"**Guardar**","height":232,"width":488,"color":3},"id":"sticky-t-save","name":"Sticky T Save","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1376,368]},{"parameters":{"content":"**[PROD] Trigger**","height":200,"width":200},"id":"sticky-p-trigger","name":"Sticky P Trigger","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[64,928]},{"parameters":{"content":"**[PROD] Sheets**","height":200,"width":200},"id":"sticky-p-sheets","name":"Sticky P Sheets","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[464,928]},{"parameters":{"content":"**[PROD] AI Agent**","height":200,"width":200},"id":"sticky-p-ai","name":"Sticky P AI","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[784,928]},{"parameters":{"content":"**[PROD] Gmail**","height":200,"width":200},"id":"sticky-p-gmail","name":"Sticky P Gmail","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1104,928]},{"parameters":{"content":"**[PROD] Log**","height":200,"width":200},"id":"sticky-p-log","name":"Sticky P Log","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1424,928]},{"parameters":{},"id":"manual-trigger","name":"Manual Trigger","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[48,432]},{"parameters":{"url":"https://jsonplaceholder.typicode.com/users","options":{}},"id":"get-subscribers","name":"GET /mock/newsletter-subscribers","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[448,432]},{"parameters":{"jsCode":"const categories = ['vino', 'oliva', 'mix'];\nconst suscriptores = items.map((item, i) => ({\n  json: {\n    email: item.json.email,\n    nombre: item.json.name,\n    empresa: item.json.company?.name || 'Particular',\n    categoria: categories[i % categories.length],\n    ciudad: item.json.address?.city || 'Buenos Aires'\n  }\n}));\nreturn suscriptores;"},"id":"segmentar","name":"Segmentar suscriptores","type":"n8n-nodes-base.code","typeVersion":2,"position":[768,432]},{"parameters":{"mode":"runOnceForEachItem","jsCode":"const { nombre, email, categoria, empresa, ciudad } = $input.item.json;\n\nconst productos = {\n  vino: { titulo: 'Colección Malbec Reserva 2024', desc: 'Nuevas cosechas con notas a frutos rojos y taninos suaves.' },\n  oliva: { titulo: 'Aceite de Oliva Extra Virgen Premium', desc: 'Prensado en frío, cosecha temprana, ideal para gastronomía.' },\n  mix: { titulo: 'Pack Degustación Golden Harvest', desc: 'Una selección de nuestros mejores vinos y aceites del año.' }\n};\n\nconst prod = productos[categoria] || productos.mix;\n\nconst html = `<!DOCTYPE html>\n<html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\">\n<div style=\"background:#1a472a;padding:20px;text-align:center;\">\n  <h1 style=\"color:#fff;margin:0;\">🌾 Golden Harvest S.A.</h1>\n  <p style=\"color:#a8d5a2;margin:5px 0;\">Newsletter Quincenal</p>\n</div>\n<div style=\"padding:30px;background:#fff;border:1px solid #e0e0e0;\">\n  <h2 style=\"color:#1a472a;\">Hola ${nombre},</h2>\n  <p>Desde <strong>${ciudad}</strong>, nos alegra compartir las últimas novedades de Golden Harvest.</p>\n  <div style=\"background:#f9f6f0;padding:20px;border-left:4px solid #c8a951;margin:20px 0;\">\n    <h3 style=\"color:#8b6914;margin-top:0;\">✨ Destacado del mes</h3>\n    <h4>${prod.titulo}</h4>\n    <p>${prod.desc}</p>\n    <a href=\"#\" style=\"background:#1a472a;color:#fff;padding:10px 20px;text-decoration:none;border-radius:4px;display:inline-block;\">Ver más →</a>\n  </div>\n  <p style=\"color:#666;font-size:12px;\">Para dejar de recibir este newsletter, <a href=\"#\">hacé clic aquí</a>.</p>\n</div>\n</body></html>`;\n\nreturn { json: { email, nombre, empresa, categoria, html, generado_en: new Date().toISOString() } };"},"id":"generar-email","name":"Generar Email HTML","type":"n8n-nodes-base.code","typeVersion":2,"position":[1104,432]},{"parameters":{"sendTo":"tiagoboberg@gmail.com","subject":"={{ '[Golden Harvest] Newsletter — ' + $json.categoria.toUpperCase() + ' — ' + $json.nombre }}","message":"={{ $json.html }}","options":{}},"id":"guardar-json","name":"Gmail — Enviar Newsletter (TESIS)","type":"n8n-nodes-base.gmail","typeVersion":2.1,"position":[1696,432],"webhookId":"4c79105d-a7e8-4cc9-a962-d0cb6b1e7fb4","credentials":{"gmailOAuth2":{"id":"vKMTOPHBSJvAmTAp","name":"Gmail account"}}},{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 1,15 * *"}]}},"id":"prod-schedule","name":"[PROD] Schedule Trigger (1° y 15°)","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[80,992],"disabled":true},{"parameters":{"documentId":{"__rl":true,"mode":"id","value":"YOUR_SHEET_ID"},"sheetName":{"__rl":true,"mode":"name","value":"Suscriptores"},"options":{}},"id":"prod-sheets-read","name":"[PROD] Google Sheets — Leer Suscriptores","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[480,992],"disabled":true},{"parameters":{"options":{}},"id":"prod-ai-agent","name":"[PROD] AI Agent (Gemini)","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":1.7,"position":[800,992],"disabled":true},{"parameters":{"modelName":"models/gemini-1.5-pro","options":{}},"id":"prod-gemini-llm","name":"[PROD] Google Gemini","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","typeVersion":1,"position":[784,1232],"disabled":true},{"parameters":{"schemaType":"manual","inputSchema":"{\"type\":\"object\",\"properties\":{\"asunto\":{\"type\":\"string\"},\"html\":{\"type\":\"string\"},\"categoria\":{\"type\":\"string\"}},\"required\":[\"asunto\",\"html\",\"categoria\"]}"},"id":"prod-output-parser","name":"[PROD] Structured Output Parser","type":"@n8n/n8n-nodes-langchain.outputParserStructured","typeVersion":1.2,"position":[976,1232],"disabled":true},{"parameters":{"sendTo":"={{ $json.email }}","subject":"={{ $json.asunto }}","message":"={{ $json.html }}","options":{}},"id":"prod-gmail","name":"[PROD] Gmail — Enviar Newsletter","type":"n8n-nodes-base.gmail","typeVersion":2.1,"position":[1120,992],"webhookId":"4ceed564-6366-45ef-b390-f878b11df57f","disabled":true},{"parameters":{"operation":"appendOrUpdate","documentId":{"__rl":true,"mode":"id","value":"YOUR_SHEET_ID"},"sheetName":{"__rl":true,"mode":"name","value":"Log Envíos"},"columns":{"mappingMode":"autoMapInputData"},"options":{}},"id":"prod-sheets-log","name":"[PROD] Google Sheets — Registrar Envío","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[1440,992],"disabled":true},{"parameters":{},"id":"limit-one","name":"Limitar a 1 (TESIS)","type":"n8n-nodes-base.limit","typeVersion":1,"position":[1424,432]}],"connections":{"Manual Trigger":{"main":[[{"node":"GET /mock/newsletter-subscribers","type":"main","index":0}]]},"GET /mock/newsletter-subscribers":{"main":[[{"node":"Segmentar suscriptores","type":"main","index":0}]]},"Segmentar suscriptores":{"main":[[{"node":"Generar Email HTML","type":"main","index":0}]]},"Generar Email HTML":{"main":[[{"node":"Limitar a 1 (TESIS)","type":"main","index":0}]]},"[PROD] Schedule Trigger (1° y 15°)":{"main":[[{"node":"[PROD] Google Sheets — Leer Suscriptores","type":"main","index":0}]]},"[PROD] Google Sheets — Leer Suscriptores":{"main":[[{"node":"[PROD] AI Agent (Gemini)","type":"main","index":0}]]},"[PROD] AI Agent (Gemini)":{"main":[[{"node":"[PROD] Gmail — Enviar Newsletter","type":"main","index":0}]]},"[PROD] Gmail — Enviar Newsletter":{"main":[[{"node":"[PROD] Google Sheets — Registrar Envío","type":"main","index":0}]]},"[PROD] Google Gemini":{"ai_languageModel":[[{"node":"[PROD] AI Agent (Gemini)","type":"ai_languageModel","index":0}]]},"