nt","name":"Sentiment Analysis","type":"n8n-nodes-base.code","typeVersion":2,"position":[1360,448]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"cond-positive","leftValue":"={{ $json.action }}","rightValue":"auto_reply","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"node-branch","name":"Positive or Negative?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1584,448]},{"parameters":{"method":"POST","url":"=https://mybusiness.googleapis.com/v4/accounts/{{$vars.GOOGLE_ACCOUNT_ID}}/locations/{{$vars.GOOGLE_LOCATION_ID}}/reviews/{{ $json.reviewId }}/reply","authentication":"predefinedCredentialType","nodeCredentialType":"googleApi","sendBody":true,"bodyParameters":{"parameters":[{}]},"options":{"response":{"response":{"neverError":true}}}},"id":"node-auto-reply","name":"Post Auto-Reply","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1776,80],"disabled":true},{"parameters":{"fromEmail":"n8n@goldenharvest.com","toEmail":"={{ $vars.ADMIN_EMAIL }}","subject":"={{ $json.priority === \"urgent\" ? \"URGENTE\" : \"Atencion\" }} - Resena Negativa en Google Maps - {{ $json.stars_numeric }} estrella(s)","options":{"appendAttribution":false}},"id":"node-email-admin","name":"Email Admin - Negative Review","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1808,592],"webhookId":"cd676d50-79bb-442a-b17f-5908e879ba50"},{"parameters":{},"id":"node-loop-back","name":"Loop Back","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[2032,448]},{"parameters":{"url":"https://maps.googleapis.com/maps/api/place/details/json","sendQuery":true,"queryParameters":{"parameters":[{"name":"place_id","value":"={{$vars.GOOGLE_PLACE_ID}}"},{"name":"fields","value":"reviews"},{"name":"key","value":"={{$vars.GOOGLE_MAPS_API_KEY}}"}]},"options":{}},"id":"node-fetch-public","name":"Fetch Public Reviews","type":"n8n-nodes-base.httpR