    {
      "parameters": {
        "jsCode": "const orders = $input.all().map(i => i.json);\nconst fecha = new Date().toLocaleDateString('es-AR', { day:'2-digit', month:'long', year:'numeric' });\n\nconst rows = orders.map(o =>\n  `<tr>\n    <td style=\"padding:6px 12px;border-bottom:1px solid #e5e7eb;\">#${o.id}</td>\n    <td style=\"padding:6px 12px;border-bottom:1px solid #e5e7eb;\">${o.customer_nombre}</td>\n    <td style=\"padding:6px 12px;border-bottom:1px solid #e5e7eb;\">${o.localidad}</td>\n    <td style=\"padding:6px 12px;border-bottom:1px solid #e5e7eb;text-align:right;\">$${o.total?.toLocaleString('es-AR')}</td>\n  </tr>`\n).join('');\n\nconst summary_html = `\n<div style=\"font-family:sans-serif;max-width:680px;margin:0 auto;padding:24px;\">\n  <h2 style=\"color:#166534;\">Golden Harvest S.A. \u2014 Remitos Generados</h2>\n  <p style=\"color:#6b7280;\">Fecha: ${fecha}</p>\n  <p>Se procesaron <strong>${orders.length}</strong> orden(es) confirmada(s):</p>\n  <table style=\"width:100%;border-collapse:collapse;font-size:14px;\">\n    <thead><tr style=\"background:#f3f4f6;\">\n      <th style=\"padding:8px 12px;text-align:left;\">Orden</th>\n      <th style=\"padding:8px 12px;text-align:left;\">Cliente</th>\n      <th style=\"padding:8px 12px;text-align:left;\">Localidad</th>\n      <th style=\"padding:8px 12px;text-align:right;\">Total</th>\n    </tr></thead>\n    <tbody>${rows}</tbody>\n  </table>\n  <p style=\"margin-top:20px;font-size:12px;color:#9ca3af;\">Golden Harvest S.A. \u2014 Sistema Automatizado de Log\u00edstica</p>\n</div>`;\n\nreturn [{ json: { summary_html, total: orders.length, fecha: new Date().toISOString().slice(0,10) } }];"
      },
