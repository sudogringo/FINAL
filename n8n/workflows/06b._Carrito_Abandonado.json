    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el correo con los productos REALES del carrito (payload validado). El carrito del\n// sitio no tiene precios, por eso la oferta se expresa como porcentaje, sin importes.\nconst { items, sessionId, nombre, email } = $input.item.json;\nconst esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[ch]);\nconst LINE = { roja: 'Línea Roja', dorada: 'Línea Dorada' };\nconst unidades = items.reduce((s, i) => s + i.qty, 0);\nconst lista = items.map((i) =>\n  `<li style=\"padding:4px 0;\">🥫 <strong>${esc(i.name)}</strong> — ${esc(LINE[i.line] ?? i.line)}${i.line ? ', ' : ''}${esc(i.size)} × ${i.qty}</li>`\n).join('');\nconst saludo = nombre ? `Hola ${esc(nombre)},` : 'Hola,';\nconst html = `<!DOCTYPE html><html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\"><div style=\"background:#1a472a;padding:20px;text-align:center;\"><h1 style=\"color:#fff;margin:0;\">🌾 Golden Harvest S.A.</h1><p style=\"color:#a8d5a2;margin:5px 0;\">¡Tu carrito te está esperando!</p></div><div style=\"padding:30px;background:#fff;border:1px solid #e0e0e0;\"><h2 style=\"color:#1a472a;\">${saludo}</h2><p>Dejaste estos productos en tu carrito hace más de <strong>2 horas</strong>:</p><ul style=\"background:#f9f6f0;padding:20px;border-radius:8px;\">${lista}</ul><p><strong>Total: ${unidades} unidades</strong></p><div style=\"background:#fff3cd;border:2px solid #c8a951;padding:20px;border-radius:8px;text-align:center;margin:20px 0;\"><h3 style=\"color:#8b6914;margin-top:0;\">🎁 OFERTA EXCLUSIVA — 10% OFF</h3><p style=\"font-size:18px;color:#1a472a;\">Pedinos la cotización de este carrito y te aplicamos 10% de descuento.</p><a href=\"#\" style=\"background:#c8a951;color:#fff;padding:15px 30px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;margin-top:10px;\">¡Completar cotización! →</a></div></div></body></html>`;\nconst asunto = '[Golden Harvest] 🛒 Carrito abandonado — 10% OFF' + (nombre ? ' — ' + nombre : '');\nreturn { json: { email, nombre, items, sessionId, unidades, descuento_pct: 10, asunto, html, generado_en: new Date().toISOString() } };"
      },
