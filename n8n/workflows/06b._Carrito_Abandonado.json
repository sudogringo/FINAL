    {
      "parameters": {
        "jsCode": "const productos = ['Malbec Reserva 750ml', 'Aceite Oliva Extra Virgen 500ml', 'Pack Degustaci\u00f3n x3', 'Malbec Gran Reserva 1.5L', 'Kit Maridaje Gourmet'];\nconst clientes = items.slice(0, 8).map((item, i) => {\n  const numP = (i % 3) + 1;\n  const prods = productos.slice(i % productos.length, (i % productos.length) + numP);\n  return { json: { cliente_id: item.json.id, email: `cliente${item.json.id}@ejemplo.com`, nombre: `Cliente ${item.json.id}`, productos_carrito: prods, total_carrito: Math.round(prods.length * 1850 * (1 + i * 0.1)), tiempo_abandono: `${(i%4)+1}h`, ciudad: ['Mendoza','Buenos Aires','C\u00f3rdoba','Rosario'][i%4] } };\n});\nreturn clientes;"
      },
      "id": "agrupar",
      "name": "Agrupar por cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        496
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { nombre, email, productos_carrito, total_carrito, tiempo_abandono, ciudad } = $input.item.json;\nconst descuento = Math.round(total_carrito * 0.10);\nconst total_final = total_carrito - descuento;\nconst lista = productos_carrito.map(p => `<li style=\"padding:4px 0;\">\ud83c\udf77 ${p}</li>`).join('');\nconst html = `<!DOCTYPE html><html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\"><div style=\"background:#1a472a;padding:20px;text-align:center;\"><h1 style=\"color:#fff;margin:0;\">\ud83c\udf3e Golden Harvest S.A.</h1><p style=\"color:#a8d5a2;margin:5px 0;\">\u00a1Tu carrito te est\u00e1 esperando!</p></div><div style=\"padding:30px;background:#fff;border:1px solid #e0e0e0;\"><h2 style=\"color:#1a472a;\">Hola ${nombre},</h2><p>Dejaste estos productos en tu carrito hace <strong>${tiempo_abandono}</strong>:</p><ul style=\"background:#f9f6f0;padding:20px;border-radius:8px;\">${lista}</ul><div style=\"background:#fff3cd;border:2px solid #c8a951;padding:20px;border-radius:8px;text-align:center;margin:20px 0;\"><h3 style=\"color:#8b6914;margin-top:0;\">\ud83c\udf81 OFERTA EXCLUSIVA \u2014 10% OFF</h3><p style=\"text-decoration:line-through;color:#999;\">Total original: $${total_carrito}</p><p style=\"font-size:24px;font-weight:bold;color:#1a472a;\">Con descuento: $${total_final}</p><a href=\"#\" style=\"background:#c8a951;color:#fff;padding:15px 30px;text-decoration:none;border-radius:4px;display:inline-block;font-weight:bold;margin-top:10px;\">\u00a1Completar compra! \u2192</a></div></div></body></html>`;\nreturn { json: { email, nombre, productos_carrito, total_carrito, descuento, total_final, html, generado_en: new Date().toISOString() } };"
      },
