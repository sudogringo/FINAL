    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Camino manual: convierte el carrito simulado en el mismo payload que envía el frontend,\n// para que pase por el mismo validador y el mismo armado de correo que el camino real.\nconst c = $input.item.json;\nconst SIZES = ['400 g', '800 g', '3 kg'];\nconst slug = (s) => s.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nconst items = c.productos_carrito.map((name, k) => ({\n  id: 'sim-' + slug(name),\n  name,\n  line: /durazno/i.test(name) ? 'dorada' : 'roja',\n  size: SIZES[(c.cliente_id + k) % SIZES.length],\n  qty: 1 + ((c.cliente_id + k) % 3),\n  stockForSize: 100,\n}));\nreturn { json: { body: {\n  items,\n  sessionId: 'sim-session-' + c.cliente_id,\n  timestamp: new Date().toISOString(),\n  contact: { nombre: c.nombre, email: c.email },\n} } };"
      },
      "id": "simular-payload",
      "name": "Simular payload del frontend",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        496
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Contrato del frontend (frontend/src/features/cart/CartContext.tsx):\n// { items: CartItem[], sessionId: string | null, timestamp: ISO }. Contacto opcional.\nconst b = $input.item.json.body;\nconst bad = (error) => ({ json: { valid: false, error } });\nif (!b || typeof b !== 'object' || Array.isArray(b)) return bad('body: se esperaba un objeto JSON');\nif (!Array.isArray(b.items) || b.items.length === 0) return bad('items: se esperaba un arreglo con al menos un producto');\nif (b.items.length > 50) return bad('items: demasiados productos (máximo 50)');\nconst str = (v) => typeof v === 'string' && v.trim() !== '';\nconst items = [];\nfor (let i = 0; i < b.items.length; i++) {\n  const it = b.items[i];\n  if (!it || typeof it !== 'object') return bad(`items[${i}]: no es un objeto`);\n  if (!str(it.id)) return bad(`items[${i}].id: texto requerido`);\n  if (!str(it.name)) return bad(`items[${i}].name: texto requerido`);\n  if (!str(it.size)) return bad(`items[${i}].size: texto requerido`);\n  if (!Number.isInteger(it.qty) || it.qty < 1) return bad(`items[${i}].qty: entero >= 1 requerido`);\n  items.push({ id: it.id, name: it.name, line: typeof it.line === 'string' ? it.line : '', size: it.size, qty: it.qty });\n}\nif (b.sessionId != null && typeof b.sessionId !== 'string') return bad('sessionId: texto o null');\nif (b.timestamp != null && (typeof b.timestamp !== 'string' || Number.isNaN(Date.parse(b.timestamp)))) return bad('timestamp: fecha ISO inválida');\nconst c = b.contact && typeof b.contact === 'object' ? b.contact : {};\nreturn { json: {\n  valid: true,\n  items,\n  sessionId: b.sessionId ?? null,\n  timestamp: b.timestamp ?? new Date().toISOString(),\n  nombre: typeof c.nombre === 'string' ? c.nombre : '',\n  email: typeof c.email === 'string' ? c.email : '',\n} };"
      },
      "id": "validar-carrito",
      "name": "Validar carrito",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
