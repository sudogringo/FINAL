    {
      "parameters": {
        "jsCode": "const productos = ['Doble Concentrado de Tomate', 'Tomate Entero Pelado', 'Mitades de Durazno en Almíbar', 'Salsa Clásica', 'Trozos de Durazno en Almíbar'];\nconst clientes = items.slice(0, 8).map((item, i) => {\n  const numP = (i % 3) + 1;\n  const prods = productos.slice(i % productos.length, (i % productos.length) + numP);\n  return { json: { cliente_id: item.json.id, email: `cliente${item.json.id}@ejemplo.com`, nombre: `Cliente ${item.json.id}`, productos_carrito: prods, total_carrito: Math.round(prods.length * 1850 * (1 + i * 0.1)), tiempo_abandono: `${(i%4)+1}h`, ciudad: ['Mendoza','Buenos Aires','Córdoba','Rosario'][i%4] } };\n});\nreturn clientes;"
      },
      "id": "agrupar",
