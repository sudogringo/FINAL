    {
      "id": "note-thesis",
      "name": "🟢 MODO TESIS",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [680, 80],
      "parameters": {
        "content": "## 🟢 MODO TESIS\n\n**Flujo activo para la demo universitaria.**\n\n1. **Schedule** (Lun y Jue 9:00) o **Manual Trigger** para testing\n2. **HTTP Request** → `GET /stats/abandoned-carts` en la API simulada\n3. **Code — Agrupar** → agrupa filas por cliente, lista sus productos\n4. **Split In Batches** → procesa un cliente a la vez\n5. **Code — Generar Email** → HTML personalizado en español con 10% descuento\n6. **Code — Guardar JSON** → escribe todos los emails en `/home/node/.n8n/emails_carrito_abandonado.json`\n\n**Sin credenciales externas necesarias.**",
        "height": 500,
        "width": 680,
        "color": 3
      }
    },
    {
      "id": "node-schedule",
      "name": "Schedule — Lun y Jue 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [780, 340],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1,4"
            }
          ]
        }
      }
    },
    {
      "id": "node-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [780, 480],
      "parameters": {}
    },
    {
      "id": "node-get-carts",
      "name": "GET /stats/abandoned-carts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 400],
      "parameters": {
        "method": "GET",
        "url": "http://backend:3001/api/stats/abandoned-carts",
        "options": {}
      }
    },
    {
      "id": "node-group",
      "name": "Agrupar por cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 400],
      "parameters": {
        "jsCode": "// HTTP Request devuelve el array como 1 item de n8n — lo expandimos\nconst raw = $input.all();\nlet filas = [];\nif (raw.length === 1 && Array.isArray(raw[0].json)) {\n  filas = raw[0].json;\n} else {\n  filas = raw.map(i => i.json);\n}\n\n// Agrupar por email\nconst porCliente = {};\nfor (const fila of filas) {\n  const email = fila.contact?.email ?? fila.email;\n  const nombre = fila.contact?.nombre ?? fila.nombre ?? 'Cliente';\n  const localidad = fila.customer?.localidad ?? fila.localidad ?? '';\n  if (!porCliente[email]) {\n    porCliente[email] = { id: fila.quoteId, nombre, email, localidad, productos: [] };\n  }\n  const items = fila.items ?? [];\n  for (const item of items) {\n    porCliente[email].productos.push({ sku: item.id ?? '', nombre: item.name ?? item.nombre ?? '', precio: 0 });\n  }\n}\n\nconst clientes = Object.values(porCliente);\nconsole.log(`Clientes con carrito abandonado: ${clientes.length}`);\nif (clientes.length === 0) console.log('Raw response:', JSON.stringify(raw[0]?.json).slice(0, 300));\n\nreturn clientes.map(c => ({ json: c }));"
      }
    },
    {
      "id": "node-split",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1520, 400],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-gen-email",
      "name": "Generar Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 400],
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst productosHtml = d.productos.map(p =>\n  `<tr>\n    <td style=\"padding:8px 12px;border-bottom:1px solid #e8e0d0;\">${p.nombre}</td>\n    <td style=\"padding:8px 12px;border-bottom:1px solid #e8e0d0;text-align:right;font-weight:bold;\">$${Number(p.precio).toLocaleString('es-AR')}</td>\n  </tr>`\n).join('');\n\nconst codigoDescuento = `GH10-${d.email.split('@')[0].toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6)}`;\nconst primerProducto = d.productos[0].nombre;\n\nconst html = `<!DOCTYPE html>\n<html lang=\"es\">\n<head><meta charset=\"UTF-8\"><title>Tu carrito te espera — Golden Harvest</title></head>\n<body style=\"margin:0;padding:0;background:#f5f0e8;font-family:Georgia,serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f5f0e8;padding:32px 0;\">\n    <tr><td align=\"center\">\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);\">\n        <!-- Header -->\n        <tr>\n          <td style=\"background:#2d5a1b;padding:28px 32px;text-align:center;\">\n            <h1 style=\"margin:0;color:#f5c842;font-size:24px;letter-spacing:1px;\">🌾 Golden Harvest S.A.</h1>\n            <p style=\"margin:8px 0 0;color:#c8e6a0;font-size:13px;\">Conservas Artesanales de Calidad Superior</p>\n          </td>\n        </tr>\n        <!-- Body -->\n        <tr>\n          <td style=\"padding:32px;\">\n            <h2 style=\"color:#2d5a1b;margin:0 0 16px;\">Hola ${d.nombre},</h2>\n            <p style=\"color:#444;line-height:1.7;margin:0 0 16px;\">\n              Notamos que estuviste mirando algunos de nuestros productos y los dejaste en tu lista de interés.\n              Queremos que puedas disfrutar de la calidad Golden Harvest, por eso preparamos algo especial para vos.\n            </p>\n            <p style=\"color:#444;line-height:1.7;margin:0 0 24px;\">\n              En especial, <strong>${primerProducto}</strong> y los demás productos que seleccionaste te están esperando.\n            </p>\n            <!-- Productos -->\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #e8e0d0;border-radius:6px;margin-bottom:24px;\">\n              <thead>\n                <tr style=\"background:#f5f0e8;\">\n                  <th style=\"padding:10px 12px;text-align:left;color:#2d5a1b;font-size:13px;\">Producto</th>\n                  <th style=\"padding:10px 12px;text-align:right;color:#2d5a1b;font-size:13px;\">Precio</th>\n                </tr>\n              </thead>\n              <tbody>${productosHtml}</tbody>\n            </table>\n            <!-- Descuento -->\n            <div style=\"background:#f5f0e8;border-left:4px solid #f5c842;padding:16px 20px;border-radius:4px;margin-bottom:24px;\">\n              <p style=\"margin:0;color:#2d5a1b;font-size:15px;\">\n                🎁 <strong>Código de descuento exclusivo:</strong>\n              </p>\n              <p style=\"margin:8px 0 0;font-size:22px;font-weight:bold;letter-spacing:3px;color:#2d5a1b;\">${codigoDescuento}</p>\n              <p style=\"margin:6px 0 0;color:#666;font-size:13px;\">Aplicá este código y obtené un <strong>10% de descuento</strong> en tu próximo pedido. Válido por 15 días.</p>\n            </div>\n            <p style=\"color:#444;line-height:1.7;margin:0 0 24px;\">\n              Para concretar tu pedido o consultar disponibilidad, respondé este email o contactanos directamente. Desde ${d.localidad} podemos coordinar el envío sin inconvenientes.\n            </p>\n            <div style=\"text-align:center;\">\n              <a href=\"mailto:ventas@goldenharvest.com.ar?subject=Pedido%20con%20descuento%20${codigoDescuento}\" style=\"display:inline-block;background:#2d5a1b;color:#ffffff;padding:14px 32px;border-radius:6px;text-decoration:none;font-size:15px;font-weight:bold;\">Completar mi pedido</a>\n            </div>\n          </td>\n        </tr>\n        <!-- Footer -->\n        <tr>\n          <td style=\"background:#f5f0e8;padding:20px 32px;text-align:center;border-top:1px solid #e8e0d0;\">\n            <p style=\"margin:0;color:#888;font-size:12px;\">Golden Harvest S.A. · San Rafael, Mendoza, Argentina</p>\n            <p style=\"margin:4px 0 0;color:#888;font-size:12px;\">ventas@goldenharvest.com.ar · +54 260 XXX-XXXX</p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    to: d.email,\n    nombre: d.nombre,\n    localidad: d.localidad,\n    subject: `${d.nombre}, te quedó algo en tu carrito de Golden Harvest 🌾`,\n    codigo_descuento: codigoDescuento,\n    productos_count: d.productos.length,\n    html\n  }\n}];"
      }
    },
    {
      "id": "node-output",
      "name": "✅ Emails listos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 400],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            { "name": "status", "stringValue": "email_generado" },
            { "name": "para", "stringValue": "={{ $json.to }}" },
            { "name": "asunto", "stringValue": "={{ $json.subject }}" },
            { "name": "codigo_descuento", "stringValue": "={{ $json.codigo_descuento }}" },
            { "name": "productos_count", "numberValue": "={{ $json.productos_count }}" },
            { "name": "html_preview", "stringValue": "={{ $json.html.slice(0, 500) }}" }
          ]
        }
      }
    }
  ],
