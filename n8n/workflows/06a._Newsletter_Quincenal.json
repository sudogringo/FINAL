    {
      "parameters": {
        "jsCode": "const categories = ['vino', 'oliva', 'mix'];\nconst suscriptores = items.map((item, i) => ({\n  json: {\n    email: item.json.email,\n    nombre: item.json.name,\n    empresa: item.json.company?.name || 'Particular',\n    categoria: categories[i % categories.length],\n    ciudad: item.json.address?.city || 'Buenos Aires'\n  }\n}));\nreturn suscriptores;"
      },
      "id": "segmentar",
      "name": "Segmentar suscriptores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        432
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { nombre, email, categoria, empresa, ciudad } = $input.item.json;\n\nconst productos = {\n  vino: { titulo: 'Colecci\u00f3n Malbec Reserva 2024', desc: 'Nuevas cosechas con notas a frutos rojos y taninos suaves.' },\n  oliva: { titulo: 'Aceite de Oliva Extra Virgen Premium', desc: 'Prensado en fr\u00edo, cosecha temprana, ideal para gastronom\u00eda.' },\n  mix: { titulo: 'Pack Degustaci\u00f3n Golden Harvest', desc: 'Una selecci\u00f3n de nuestros mejores vinos y aceites del a\u00f1o.' }\n};\n\nconst prod = productos[categoria] || productos.mix;\n\nconst html = `<!DOCTYPE html>\n<html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\">\n<div style=\"background:#1a472a;padding:20px;text-align:center;\">\n  <h1 style=\"color:#fff;margin:0;\">\ud83c\udf3e Golden Harvest S.A.</h1>\n  <p style=\"color:#a8d5a2;margin:5px 0;\">Newsletter Quincenal</p>\n</div>\n<div style=\"padding:30px;background:#fff;border:1px solid #e0e0e0;\">\n  <h2 style=\"color:#1a472a;\">Hola ${nombre},</h2>\n  <p>Desde <strong>${ciudad}</strong>, nos alegra compartir las \u00faltimas novedades de Golden Harvest.</p>\n  <div style=\"background:#f9f6f0;padding:20px;border-left:4px solid #c8a951;margin:20px 0;\">\n    <h3 style=\"color:#8b6914;margin-top:0;\">\u2728 Destacado del mes</h3>\n    <h4>${prod.titulo}</h4>\n    <p>${prod.desc}</p>\n    <a href=\"#\" style=\"background:#1a472a;color:#fff;padding:10px 20px;text-decoration:none;border-radius:4px;display:inline-block;\">Ver m\u00e1s \u2192</a>\n  </div>\n  <p style=\"color:#666;font-size:12px;\">Para dejar de recibir este newsletter, <a href=\"#\">hac\u00e9 clic aqu\u00ed</a>.</p>\n</div>\n</body></html>`;\n\nreturn { json: { email, nombre, empresa, categoria, html, generado_en: new Date().toISOString() } };"
      },
      "id": "generar-email",
      "name": "Generar Email HTML",
      "type": "n8n-nodes-base.code",
