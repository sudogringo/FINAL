    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Dependencia 01 -> 04: toma la última paleta que guardó el workflow 01 (archivo JSON) y la agrega al\n// ítem. El nodo de lectura devuelve solo el archivo: los datos del post se recuperan del nodo anterior.\nconst base = $('Resolver Imagen (Unsplash)').item.json;\nconst DEFAULT = ['#1a472a', '#c8a951'];\nlet palette = DEFAULT, source = 'default', url = null, extractedAt = null;\ntry {\n  if ($input.item.binary && $input.item.binary.data) {\n    const buf = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\n    const saved = JSON.parse(buf.toString('utf8'));\n    const ok = Array.isArray(saved.palette) && saved.palette.length > 0\n      && saved.palette.every((h) => typeof h === 'string' && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(h));\n    if (ok) {\n      palette = saved.palette.slice(0, 5);\n      source = 'workflow-01';\n      url = saved.url ?? null;\n      extractedAt = saved.extractedAt ?? null;\n    }\n  }\n} catch (e) { /* archivo ilegible: se usa la paleta por defecto */ }\nreturn { json: { ...base, palette, palette_source: source, palette_url: url, palette_extracted_at: extractedAt } };"
      },
