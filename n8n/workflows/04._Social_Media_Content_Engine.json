        "jsCode": "// Contrato del botón \"Publicar en redes\" (frontend/src/pages/admin/AdminProductsPage.tsx):\n// { name, description, line, tag, imageUrl }. Solo el nombre es obligatorio.\nconst b = $input.item.json.body;\nconst bad = (error) => ({ json: { valid: false, error } });\nif (!b || typeof b !== 'object' || Array.isArray(b)) return bad('body: se esperaba un objeto JSON');\nif (typeof b.name !== 'string' || b.name.trim() === '') return bad('name: texto requerido');\nconst txt = (v) => (typeof v === 'string' ? v.trim() : '');\nreturn { json: {\n  valid: true,\n  source: 'webhook',\n  producto: b.name.trim(),\n  descripcion: txt(b.description),\n  imagen_url: txt(b.imageUrl),\n  // El botón no envía destinatario: en TESIS los posts van a la bandeja de demostración.\n  email: 'bandeja.demo@example.com',\n  plataformas: 'Instagram,WhatsApp Story,Facebook',\n  linea: txt(b.line),\n  etiqueta: txt(b.tag),\n} };"
      },
