roducto.toLowerCase().replace(/[^a-z0-9]/g, '').substring(0, 20) || 'harvest';\n  imageUrl = `https://picsum.photos/seed/${seed}/800/600`;\n}\n\nreturn { ...$input.item.json, imagen_url_final: imageUrl };\n"},"id":"image-resolver","name":"Resolver Imagen (Unsplash)","type":"n8n-nodes-base.code","position":[864,672],"typeVersion":2},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst BASE_AGRO_TAGS = [\n  'agro', 'agricultura', 'campo', 'agronegocio', 'cosecha',\n  'vino', 'viticultura', 'mendoza', 'argentina', 'export',\n  'calidad', 'sustentable', 'goldenharvestsa'\n];\n\nconst text = ((($input.item.json.producto || '') + ' ' + ($input.item.json.descripcion || ''))).toLowerCase();\nconst words = text.match(/[a-záéíóúüñ]{4,}/gi) || [];\nconst unique = [...new Set(words)].filter(w => !['para','como','este','esta','con','los','las','una','que'].includes(w));\nconst keywordTags = unique.slice(0, 5).map(w => '#' + w);\nconst baseTags = BASE_AGRO_TAGS.map(t => '#' + t);\nconst allTags = [...new Set([...keywordTags, ...baseTags])];\n\nreturn { ...$input.item.json, hashtags: allTags.join(' '), hashtags_array: allTags };\n"},"id":"tag-generator","name":"Generar Hashtags (Rule-based)","type":"n8n-nodes-base.code","position":[1104,672],"typeVersion":2},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst { producto, descripcion, fecha, imagen_url_final, hashtags, hashtags_array, source, email, plataformas, row_number } = $input.item.json;\n\nconst shortDesc = descripcion.length > 120 ? descripcion.substring(0, 117) + '...' : descripcion;\nconst tags5 = (hashtags_array || []).slice(0, 5).join(' ');\nconst tags10 = (hashtags_array || []).slice(0, 10).join(' ');\n\nconst instagram = `🌾 ${producto}\n\n${descripcion}\n\n✨ Disponible ahora. Consultanos por DM o visitá nuestro sitio.\n\n${tags10}\n\n📸 Imagen sugerida: ${imagen_url_final}`;\n\nconst whatsapp = `🌾 *${producto}*\n${shortDesc}\n\n💬 Consultanos por este medio para más info.\n${tags5}`;\n\nconst facebook = `🌾 Golden Harvest S.A. — ${producto}\n\n${descripcion}\n\n📅 Fecha sugerida de publicación: ${fecha || 'A confirmar'}\n🔗 Visitá nuestro sitio para más información.\n\n${tags10}\n\n📸 ${imagen_url_final}`;\n\nreturn {\n  source,\n  email,\n  row_number,\n  producto,\n  fecha,\n  hashtags,\n  imagen_url_final,\n  post_instagram: instagram,\n  post_whatsapp: whatsapp,\n  post_facebook: facebook\n};\n"},"id":"format-posts","name":"Formatear Posts","type":"n8n-nodes-base.code","position":[1344,672],"typeVersion":2},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"leftValue":"={{ $json.source }}","rightValue":"form","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"if-output","name":"¿Enviar email o escribir sheet?","type":"n8n-nodes-base.if","position":[1584,672],"typeVersion":2.2},{"parameters":{"sendTo":"={{ $json.email }}","subject":"={{ '🌾 Posts listos — ' + $json.producto }}","message":"={{ \n'<h2>🌾 Golden Harvest — Contenido Social Listo</h2>' +\n'<p><b>Producto:</b> ' + $json.producto + '</p>' +\n'<p><b>Imagen sugerida:</b> <a href=\"' + $json.imagen_url_final + '\">' + $json.imagen_url_final + '</a></p>' +\n'<hr>' +\n'<h3>📸 Instagram</h3><pre style=\"background:#f4f4f4;padding:12px;border-radius:6px\">' + $json.post_instagram + '</pre>' +\n'<hr>' +\n'<h3>💬 WhatsApp Story</h3><pre style=\"background:#f4f4f4;padding:12px;border-radius:6px\">' + $json.post_whatsapp + '</pre>' +\n'<hr>' +\n'<h3>👍 Facebook</h3><pre style=\"background:#f4f4f4;padding:12px;border-radius:6px\">' + $json.post_facebook + '</pre>' +\n'<hr><p style=\"color:#999;font-size:12px\">Generado por Golden Harvest Social Content Engine — WF4</p>'\n}}","options":{}},"id":"gmail-send","name":"Enviar Email con Posts","type":"n8n-nodes-base.gmail","position":[1824,560],"typeVersion":2.1,"webhookId":"c32b2bcd-f568-4285-b513-9c2dca4ed329","credentials":{"gmailOAuth2":{"id":"vKMTOPHBSJ