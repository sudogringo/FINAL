    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst producto = $input.item.json.producto || '';\nconst existing = $input.item.json.imagen_url || '';\n\nlet imageUrl = existing.trim();\nif (!imageUrl) {\n  // Lorem Picsum — reliable free image service, no API key needed\n  // seed from product name so same product always gets same image\n  const seed = producto.toLowerCase().replace(/[^a-z0-9]/g, '').substring(0, 20) || 'harvest';\n  imageUrl = `https://picsum.photos/seed/${seed}/800/600`;\n}\n\nreturn { ...$input.item.json, imagen_url_final: imageUrl };\n"
      },
      "id": "image-resolver",
      "name": "Resolver Imagen (Unsplash)",
      "type": "n8n-nodes-base.code",
      "position": [
        864,
        672
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst BASE_AGRO_TAGS = [\n  'agro', 'agricultura', 'campo', 'agronegocio', 'cosecha',\n  'conservas', 'hortalizas', 'mendoza', 'argentina', 'export',\n  'calidad', 'sustentable', 'goldenharvestsa'\n];\n\nconst text = ((($input.item.json.producto || '') + ' ' + ($input.item.json.descripcion || ''))).toLowerCase();\nconst words = text.match(/[a-záéíóúüñ]{4,}/gi) || [];\nconst unique = [...new Set(words)].filter(w => !['para','como','este','esta','con','los','las','una','que'].includes(w));\nconst keywordTags = unique.slice(0, 5).map(w => '#' + w);\nconst baseTags = BASE_AGRO_TAGS.map(t => '#' + t);\nconst allTags = [...new Set([...keywordTags, ...baseTags])];\n\nreturn { ...$input.item.json, hashtags: allTags.join(' '), hashtags_array: allTags };\n"
      },
      "id": "tag-generator",
      "name": "Generar Hashtags (Rule-based)",
      "type": "n8n-nodes-base.code",
      "position": [
        1104,
        672
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { producto, descripcion, fecha, imagen_url_final, hashtags, hashtags_array, source, email, plataformas, row_number, palette, palette_source, palette_url, palette_extracted_at } = $input.item.json;\n\nconst shortDesc = descripcion.length > 120 ? descripcion.substring(0, 117) + '...' : descripcion;\nconst tags5 = (hashtags_array || []).slice(0, 5).join(' ');\nconst tags10 = (hashtags_array || []).slice(0, 10).join(' ');\n// Paleta de marca que dejó el workflow 01 (o la de respaldo si todavía no corrió).\nconst colores = (palette && palette.length ? palette : []).join(' ');\nconst imagen_prompt = `Foto publicitaria de ${producto}, estilo Golden Harvest, colores de marca ${(palette || []).join(', ')}`;\n\nconst instagram = `🌾 ${producto}\n\n${descripcion}\n\n✨ Disponible ahora. Consultanos por DM o visitá nuestro sitio.\n\n${tags10}\n\n📸 Imagen sugerida: ${imagen_url_final}\n🎨 Paleta de marca: ${colores}`;\n\nconst whatsapp = `🌾 *${producto}*\n${shortDesc}\n\n💬 Consultanos por este medio para más info.\n${tags5}\n🎨 ${colores}`;\n\nconst facebook = `🌾 Golden Harvest S.A. — ${producto}\n\n${descripcion}\n\n📅 Fecha sugerida de publicación: ${fecha || 'A confirmar'}\n🔗 Visitá nuestro sitio para más información.\n\n${tags10}\n\n📸 ${imagen_url_final}\n🎨 Paleta de marca: ${colores}`;\n\nreturn {\n  source,\n  email,\n  row_number,\n  producto,\n  fecha,\n  hashtags,\n  imagen_url_final,\n  imagen_prompt,\n  palette,\n  palette_source,\n  palette_url,\n  palette_extracted_at,\n  post_instagram: instagram,\n  post_whatsapp: whatsapp,\n  post_facebook: facebook\n};"
      },
      "id": "format-posts",
      "name": "Formatear Posts",
      "type": "n8n-nodes-base.code",
      "position": [
        1344,
        672
      ],
      "typeVersion": 2
    },
