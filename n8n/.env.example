# n8n master encryption key — encrypts everything in the credentials manager.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# n8n's own REST API key (Settings -> n8n API in the UI). Leave empty until generated.
API_KEY=

N8N_HOST=localhost
N8N_PORT=4343
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:4343/
N8N_EDITOR_BASE_URL=http://localhost:4343
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires
