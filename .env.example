# Root-level vars consumed directly by docker-compose.yml.
# Copy to .env and fill in — the same values also need to live in
# backend/.env / frontend/.env / n8n/.env for non-Docker (npm run dev) usage.

JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
N8N_QUOTE_WEBHOOK=http://localhost:4343/webhook/quote
ABANDONED_CART_THRESHOLD_MS=7200000

N8N_ENCRYPTION_KEY=changeme-generate-a-real-random-key
N8N_HOST=localhost
N8N_PORT=4343
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:4343/
N8N_EDITOR_BASE_URL=http://localhost:4343
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires
