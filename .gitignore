Docs/otro.pdf

# Environment variables — never commit real secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# SQLite WAL temp files — runtime-only, regenerated by n8n, never meaningful to commit
n8n/data/*.sqlite-shm
n8n/data/*.sqlite-wal

# n8n runtime data — contains real encrypted credentials (OAuth2 tokens, API keys)
# and machine-local state. Workflow *definitions* are versioned separately as JSON
# exports in n8n/workflows/ — share database.sqlite + N8N_ENCRYPTION_KEY with
# collaborators outside of git (see docs/architecture/n8n.md).
n8n/data/database.sqlite
n8n/data/config
n8n/data/*.log
n8n/data/crash.journal
n8n/data/nodes/node_modules/
