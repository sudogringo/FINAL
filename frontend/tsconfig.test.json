{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist-test",
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/__tests__",
    "src/features",
    "src/data",
    "src/components",
    "src/config.ts"
  ]
}
